#!/usr/bin/env python3
"""td_fish_completions - Dynamic Fish Shell Completion Generator & Installer.

Inspects all T-Dynamos (td_*) scripts, extracts their argument parsers,
generates rich Fish completion definitions with smart argument suggestions
(battery devices, directories, file paths, choices), and installs them to
~/.config/fish/completions/.

Author: Ansh Dadwal (T-Dynamos) & Antigravity
License: MIT
"""

import os
import re
import sys
import glob
import json
import argparse
import subprocess
import importlib.util
import importlib.machinery
from pathlib import Path

# Resolve shared data directory and insert into sys.path
_DATA_DIR = Path(__file__).resolve().parent / "td_script_data"
if not _DATA_DIR.is_dir():
    _DATA_DIR = Path.home() / ".local" / "bin" / "td_script_data"
if str(_DATA_DIR) not in sys.path:
    sys.path.insert(0, str(_DATA_DIR))

from common import Colors, supports_color


def get_default_completions_dir() -> Path:
    """Return the user's Fish completion directory based on XDG or ~/.config."""
    xdg_config = os.environ.get("XDG_CONFIG_HOME")
    if xdg_config:
        return Path(xdg_config) / "fish" / "completions"
    return Path.home() / ".config" / "fish" / "completions"


def discover_scripts(
    target_names: list[str] | None = None,
    search_dirs: list[Path] | None = None,
) -> dict[str, Path]:
    """Find all candidate td_* executable scripts."""
    if search_dirs is None:
        script_dir = Path(__file__).resolve().parent
        home_bin = Path.home() / ".local" / "bin"
        search_dirs = [script_dir, home_bin]

    found: dict[str, Path] = {}
    for d in search_dirs:
        if not d.is_dir():
            continue
        for entry in sorted(d.glob("td_*")):
            if entry.is_file() and not entry.name.endswith((".fish", ".html", ".bak", ".tmp")):
                # Do not re-add if already found
                if entry.name not in found:
                    found[entry.name] = entry

    if target_names:
        found = {k: v for k, v in found.items() if k in target_names}

    return found


def extract_parser(script_path: Path) -> argparse.ArgumentParser | None:
    """Dynamically load script module and extract its ArgumentParser."""
    cmd_name = script_path.name
    try:
        loader = importlib.machinery.SourceFileLoader(cmd_name, str(script_path))
        spec = importlib.util.spec_from_loader(cmd_name, loader)
        if spec and spec.loader:
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if hasattr(mod, "build_parser") and callable(mod.build_parser):
                return mod.build_parser()
    except Exception:
        pass
    return None


def generate_fish_from_parser(cmd_name: str, parser: argparse.ArgumentParser) -> str:
    """Generate Fish completion directives from an argparse.ArgumentParser."""
    lines: list[str] = [
        f"# Fish completion for {cmd_name}",
        "# Dynamically generated by td_fish_completions",
        f"complete -c {cmd_name} -e",
        "",
    ]

    has_file_positional = False

    # Check positional arguments
    for a in parser._actions:
        if not a.option_strings:
            # Positional argument
            metavar = (a.metavar or a.dest or "").lower()
            if any(k in metavar for k in ("file", "path", "image", "img", "output")):
                has_file_positional = True

            # Only suggest explicit finite choices (e.g. td_script_info script choices)
            # Never inject raw multi-word string templates into positional completions.
            if a.choices:
                choices_str = " ".join(str(c) for c in a.choices)
                desc = (a.help or f"Choose {a.dest}").replace('"', r"\"")
                lines.append(f'complete -c {cmd_name} -n "__fish_is_first_token" -f -a "{choices_str}" -d "{desc}"')

    # If the command does not take files as positional arguments, disable default file completion
    if not has_file_positional:
        lines.append(f"complete -c {cmd_name} -f")
        lines.append("")

    # Process options and flags
    for a in parser._actions:
        if not a.option_strings:
            continue

        cmd_parts = ["complete", "-c", cmd_name]

        shorts = [opt.lstrip("-") for opt in a.option_strings if opt.startswith("-") and not opt.startswith("--")]
        longs = [opt.lstrip("-") for opt in a.option_strings if opt.startswith("--")]

        for s in shorts:
            cmd_parts.extend(["-s", s])
        for l in longs:
            cmd_parts.extend(["-l", l])

        action_type = type(a).__name__
        is_flag = action_type in (
            "_StoreTrueAction",
            "_StoreFalseAction",
            "_HelpAction",
            "_VersionAction",
            "_CountAction",
        )

        if not is_flag and a.nargs != 0:
            cmd_parts.append("-r")

            opt_names = [s.lower() for s in shorts] + [l.lower() for l in longs]
            dest = (a.dest or "").lower()
            metavar = (a.metavar or "").lower()

            if a.choices:
                choices_str = " ".join(str(c) for c in a.choices)
                cmd_parts.extend(["-f", "-a", f'"{choices_str}"'])
            elif any(k in opt_names or k in dest or k in metavar for k in ("battery", "bat")):
                cmd_parts.extend(["-f", "-a", '"(ls /sys/class/power_supply/ 2>/dev/null)"'])
            elif any(k in opt_names or k in dest or k in metavar for k in ("dir", "directory")):
                cmd_parts.extend(["-f", "-a", '"(__fish_complete_directories)"'])
            elif any(k in opt_names or k in dest or k in metavar for k in ("color", "bg")):
                cmd_parts.extend(["-f", "-a", '"white black transparent cyan magenta yellow red green blue"'])
            elif any(k in opt_names or k in dest or k in metavar for k in ("file", "path", "save", "img", "out")):
                cmd_parts.append("-F")
            elif any(k in opt_names or k in dest or k in metavar for k in ("viewer", "clipboard")):
                cmd_parts.extend(["-f", "-a", '"(__fish_complete_subcommand)"'])
            elif any(k in opt_names or k in dest for k in ("scripts", "script")):
                cmd_parts.extend(["-f", "-a", '"(ls -1 ~/.local/bin/td_* 2>/dev/null | xargs -n1 basename 2>/dev/null)"'])
            else:
                cmd_parts.append("-f")
        else:
            cmd_parts.append("-f")

        desc = (a.help or "").strip()
        # Clean up multi-space or newlines in help
        desc = " ".join(desc.split())
        desc = desc.replace("\\", r"\\").replace('"', r"\"")
        cmd_parts.extend(["-d", f'"{desc}"'])

        lines.append(" ".join(cmd_parts))

    return "\n".join(lines) + "\n"


def generate_fish_from_help(cmd_name: str, script_path: Path) -> str:
    """Fallback generator that parses command --help output."""
    try:
        proc = subprocess.run([str(script_path), "--help"], capture_output=True, text=True, timeout=3)
        help_text = proc.stdout
    except Exception:
        help_text = ""

    lines = [
        f"# Fish completion for {cmd_name}",
        "# Generated from --help by td_fish_completions",
        f"complete -c {cmd_name} -e",
        f"complete -c {cmd_name} -f",
        "",
    ]

    opt_pattern = re.compile(
        r"^\s*(?:(-[a-zA-Z0-9]),?\s*)?(?:(--[a-zA-Z0-9_-]+))?(?:\s+([A-Z0-9_-]+))?\s{2,}(.*)$"
    )

    for line in help_text.splitlines():
        match = opt_pattern.match(line)
        if match:
            short, long, metavar, desc = match.groups()
            if not short and not long:
                continue

            cmd_parts = ["complete", "-c", cmd_name]
            if short:
                cmd_parts.extend(["-s", short.lstrip("-")])
            if long:
                cmd_parts.extend(["-l", long.lstrip("-")])

            if metavar:
                cmd_parts.append("-r")
                if "DIR" in metavar.upper():
                    cmd_parts.extend(["-f", "-a", '"(__fish_complete_directories)"'])
                elif any(k in metavar.upper() for k in ("FILE", "PATH", "OUT")):
                    cmd_parts.append("-F")
                else:
                    cmd_parts.append("-f")
            else:
                cmd_parts.append("-f")

            desc_clean = (desc or "").strip().replace('"', r"\"")
            cmd_parts.extend(["-d", f'"{desc_clean}"'])
            lines.append(" ".join(cmd_parts))

    return "\n".join(lines) + "\n"


def generate_completion_for_script(script_path: Path) -> tuple[str, str]:
    """Generate Fish completion code for a single script path.

    Returns (cmd_name, completion_content).
    """
    cmd_name = script_path.name
    parser = extract_parser(script_path)
    if parser is not None:
        content = generate_fish_from_parser(cmd_name, parser)
    else:
        content = generate_fish_from_help(cmd_name, script_path)
    return cmd_name, content


def build_parser() -> argparse.ArgumentParser:
    """Construct CLI argument parser for td_fish_completions."""
    default_dir = get_default_completions_dir()
    parser = argparse.ArgumentParser(
        prog="td_fish_completions",
        description="Dynamic Fish Shell Completion Generator & Installer for T-Dynamos scripts.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""Examples:
  %(prog)s
  %(prog)s --dry-run
  %(prog)s --print td_battery_watch
  %(prog)s --dir ~/.config/fish/completions
  %(prog)s --list
  %(prog)s -j
""",
    )
    parser.add_argument(
        "-d",
        "--dir",
        type=Path,
        default=default_dir,
        help=f"Target directory for Fish completion files (default: {default_dir}).",
    )
    parser.add_argument(
        "-p",
        "--print",
        nargs="?",
        const="ALL",
        metavar="SCRIPT",
        help="Print generated Fish completion code to stdout without installing (optional script name).",
    )
    parser.add_argument(
        "-l",
        "--list",
        action="store_true",
        help="List all discovered td_* scripts and their parser status.",
    )
    parser.add_argument(
        "-s",
        "--scripts",
        nargs="+",
        metavar="SCRIPT",
        help="Specify one or more specific td_* scripts to generate completions for.",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Show what files would be installed without writing to disk.",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Force overwrite existing completion files (default behavior).",
    )
    parser.add_argument(
        "-j",
        "--json",
        action="store_true",
        help="Output discovery and installation results in JSON format.",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI colored output.",
    )
    return parser


def main() -> int:
    """Main execution flow."""
    parser = build_parser()
    args = parser.parse_args()

    use_color = sys.stdout.isatty() and not args.no_color
    bold = "\033[1m" if use_color else ""
    green = "\033[32m" if use_color else ""
    cyan = "\033[36m" if use_color else ""
    yellow = "\033[33m" if use_color else ""
    reset = "\033[0m" if use_color else ""

    scripts_map = discover_scripts(target_names=args.scripts)

    # 1. Handle --list
    if args.list:
        if args.json:
            result = []
            for name, path in sorted(scripts_map.items()):
                p = extract_parser(path)
                result.append({
                    "name": name,
                    "path": str(path),
                    "has_build_parser": p is not None,
                    "options_count": len(p._actions) if p else 0,
                })
            print(json.dumps(result, indent=2))
        else:
            print(f"{bold}Discovered T-Dynamos Scripts ({len(scripts_map)}):{reset}")
            for name, path in sorted(scripts_map.items()):
                p = extract_parser(path)
                status = f"{green}ArgumentParser ({len(p._actions)} options){reset}" if p else f"{yellow}--help fallback{reset}"
                print(f"  • {bold}{name:<20}{reset} [{status}] ({path})")
        return 0

    # 2. Handle --print
    if args.print:
        target = args.print
        if target != "ALL" and target not in scripts_map:
            print(f"Error: Script '{target}' not found in discovered scripts.", file=sys.stderr)
            return 1

        selected = {target: scripts_map[target]} if target != "ALL" else scripts_map
        for name, path in sorted(selected.items()):
            _, content = generate_completion_for_script(path)
            print(content)
        return 0

    # 3. Generate completions
    results: list[dict] = []
    target_dir: Path = args.dir

    if not args.dry_run:
        target_dir.mkdir(parents=True, exist_ok=True)

    for name, path in sorted(scripts_map.items()):
        cmd_name, content = generate_completion_for_script(path)
        dest_file = target_dir / f"{cmd_name}.fish"
        lines_count = len(content.splitlines())

        if not args.dry_run:
            dest_file.write_text(content, encoding="utf-8")

        results.append({
            "command": cmd_name,
            "source_script": str(path),
            "completion_file": str(dest_file),
            "lines": lines_count,
            "installed": not args.dry_run,
        })

    # Output results
    if args.json:
        print(json.dumps({
            "target_dir": str(target_dir),
            "dry_run": args.dry_run,
            "completions": results,
        }, indent=2))
    else:
        prefix = f"{yellow}[DRY-RUN] Would install{reset}" if args.dry_run else f"{green}Installed{reset}"
        print(f"{bold}==> Fish Shell Completions Generator{reset}")
        print(f"Target Directory: {cyan}{target_dir}{reset}")
        print(f"Total Scripts   : {len(results)}\n")

        for r in results:
            print(f"  • {prefix} {bold}{r['command']}.fish{reset} ({r['lines']} completion directives)")

        if not args.dry_run:
            print(f"\n{bold}{green}Success!{reset} Fish shell completions are active in your current and new sessions.")
            print("To test completions right now in Fish shell:")
            print(f"  {cyan}td_battery_watch -<TAB>{reset}")
            print(f"  {cyan}td_math2img --<TAB>{reset}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
