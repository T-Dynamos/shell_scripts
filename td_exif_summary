        choices=["auto", "exiftool", "pillow"],
        default="auto",
        help="EXIF extraction engine to use (default: auto -> exiftool when available, else Pillow).",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI colored output.",
    )
    return parser


def main() -> int:
    """Main execution flow."""
    parser = build_parser()
    args = parser.parse_args(normalize_argv(sys.argv[1:]))

    if args.shutter:
        args.sort = "shutter"
        args.bare = True

    use_color = sys.stdout.isatty() and not args.no_color

    target_path = Path(args.path).resolve()
    if not target_path.exists():
        print(f"Error: Target path '{args.path}' does not exist.", file=sys.stderr)
        return 1

    has_exiftool = shutil.which("exiftool") is not None
    use_exiftool = (args.engine == "exiftool") or (args.engine == "auto" and has_exiftool)

    records = []
    if use_exiftool:
        records = extract_with_exiftool([str(target_path)], recursive=args.recursive)

    if not records and HAS_PILLOW:
        files = find_files([str(target_path)], recursive=args.recursive)
        if files:
            records = extract_with_pillow(files)

    if not records:
        if args.json:
            print(json.dumps({"error": "No image files found or EXIF metadata available.", "count": 0}))
        else:
            print(f"No image files found in '{args.path}' matching supported formats.")
        return 0

    def get_sort_key(r):
        if args.sort == "date":
            return r.get("datetime_str") or ""
        elif args.sort == "iso":
            val = r.get("iso")
            return val if val is not None else (0 if args.reverse else float("inf"))
        elif args.sort == "shutter":
            val = r.get("shutter_sec")
            return val if val is not None else (0.0 if args.reverse else float("inf"))
        elif args.sort == "aperture":
            val = r.get("f_number")
            return val if val is not None else (0.0 if args.reverse else float("inf"))
        elif args.sort == "focal":
            val = r.get("focal_length")
            return val if val is not None else (0.0 if args.reverse else float("inf"))
        elif args.sort == "size":
            return r.get("size_bytes") or 0
        else:
            return r.get("filename", "").lower()

    records.sort(key=get_sort_key, reverse=args.reverse)

    if args.bare:
        limit_val = None if args.limit <= 0 else args.limit
        print_bare(
            records,
            target_path=target_path,
            sort_field=args.sort,
            filenames_only=args.filenames,
            with_value=args.with_value,
            limit=limit_val,
            backslash=args.backslash,
        )
        return 0

    stats = calculate_stats(records)

    if args.json:
        serializable_records = []
        for r in records:
            item = dict(r)
            item.pop("datetime_obj", None)
            serializable_records.append(item)
        print(json.dumps({
            "target": str(target_path),
            "summary": stats,
            "images": serializable_records,
        }, indent=2))
        return 0

    if args.csv:
        print_csv(records)
        return 0

    target_label = target_path.name if target_path.is_dir() else str(target_path)
    limit_val = None if args.limit <= 0 else args.limit

    if not args.summary_only:
        show_date = args.date or args.full
        show_camera = args.camera or args.full
        show_mode = args.mode or args.full
        show_flash = args.flash or args.full

        if HAS_RICH:
            print_rich_table(
                records,
                target_label=target_label,
                use_color=use_color,
                limit=limit_val,
                show_date=show_date,
                show_camera=show_camera,
                show_mode=show_mode,
                show_flash=show_flash,
            )
        else:
            print_plain_table(
                records,
                use_color=use_color,
                limit=limit_val,
                show_date=show_date,
                show_camera=show_camera,
                show_mode=show_mode,
                show_flash=show_flash,
            )

    if not args.table_only:
        if HAS_RICH:
            print_rich_dashboard(stats, target_label=target_label, use_color=use_color)
        else:
            print_plain_dashboard(stats, target_label=target_label, use_color=use_color)

    return 0


if __name__ == "__main__":
    sys.exit(main())
