            iso_str = f"{iso_color}{iso:<7}{reset}"
        else:
            iso_str = f"{dim}{'N/A':<7}{reset}"

        ev_str = f"{dim}{r.get('exposure_bias_str', '0.0'):<6}{reset}"
        row_parts.extend([lens_str, focal_str, shut_str, fnum_str, iso_str, ev_str])

