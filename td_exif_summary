IMAGE_EXTENSIONS = {
    ".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff",
    ".dng", ".nef", ".cr2", ".cr3", ".arw", ".raw", ".orf", ".rw2", ".pef"
}


def parse_shutter_seconds(val) -> float | None:
    """Parse exposure time string or number into seconds as float."""
    if val is None:
        return None
    if isinstance(val, (int, float)):
        return float(val) if val > 0 else None
    s = str(val).strip().rstrip("s")
    if "/" in s:
        parts = s.split("/")
        if len(parts) == 2:
            try:
                num = float(parts[0])
                denom = float(parts[1])
                return (num / denom) if denom != 0 else None
            except ValueError:
                return None
    try:
        f = float(s)
        return f if f > 0 else None
    except ValueError:
        return None


def format_shutter(sec: float | None, orig_str: str | None = None) -> str:
    """Format exposure time in seconds to standard photography notation (e.g. 1/250s, 32s)."""
    if sec is None:
        if orig_str:
            s = str(orig_str).strip()
            return f"{s}s" if not s.endswith("s") else s
        return "N/A"
    if sec < 0.3:
        denom = round(1.0 / sec)
        return f"1/{denom}s"
    elif sec == int(sec):
        return f"{int(sec)}s"
    else:
        return f"{sec:.1f}s"


def format_aperture(fnum: float | None) -> str:
    """Format f-number to standard notation (e.g. f/2.8, f/8.0)."""
    if fnum is None or fnum <= 0:
        return "N/A"
    return f"f/{fnum:.1f}" if fnum % 1 != 0 else f"f/{int(fnum)}"


def format_focal(focal: float | None, focal_35mm: int | float | None = None) -> str:
    """Format focal length (e.g. 70mm or 70mm (105mm eq))."""
    if focal is None or focal <= 0:
        return "N/A"
    base = f"{focal:.1f}mm" if (focal % 1 != 0 and focal < 10) else f"{int(round(focal))}mm"
    if focal_35mm and float(focal_35mm) > 0 and abs(float(focal_35mm) - focal) > 1:
        eq_val = int(round(float(focal_35mm)))
        return f"{base} ({eq_val}mm)"
    return base


def format_ev(ev) -> str:
    """Format exposure bias value in EV (e.g. 0.0 EV, -0.7 EV, +1.3 EV)."""
    if ev is None:
        return "0.0"
    if isinstance(ev, (int, float)):
        sign = "+" if ev > 0 else ""
        return f"{sign}{ev:.1f}"
    s = str(ev).strip()
    if s in ["0", "0.0", "0/1", "+0"]:
        return "0.0"
    if "/" in s:
        try:
            parts = s.split("/")
            val = float(parts[0]) / float(parts[1])
            sign = "+" if val > 0 else ""
            return f"{sign}{val:.1f}"
        except Exception:
            return s
    try:
        f = float(s)
        sign = "+" if f > 0 else ""
        return f"{sign}{f:.1f}"
    except Exception:
        return s


def format_bytes(bytes_count: int | None) -> str:
    """Format file size in human readable units."""
    if bytes_count is None or bytes_count < 0:
        return "N/A"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if bytes_count < 1024.0 or unit == "TB":
            return f"{bytes_count:.1f} {unit}" if unit in ["MB", "GB", "TB"] else f"{int(bytes_count)} {unit}"
        bytes_count /= 1024.0
    return f"{bytes_count:.1f} MB"


def format_span(td) -> str:
    """Format a timedelta span into human-readable duration."""
    total_sec = int(td.total_seconds())
    if total_sec < 60:
        return f"{total_sec}s"
    minutes = total_sec // 60
    if minutes < 60:
        rem_sec = total_sec % 60
        return f"{minutes}m {rem_sec}s" if rem_sec else f"{minutes}m"
    hours = minutes // 60
    rem_min = minutes % 60
    if hours < 24:
        return f"{hours}h {rem_min}m" if rem_min else f"{hours}h"
    days = hours // 24
    rem_hours = hours % 24
    return f"{days}d {rem_hours}h" if rem_hours else f"{days}d"


def make_bar(ratio: float, width: int = 15) -> str:
    """Render a horizontal progress bar."""
    filled = int(round(ratio * width))
    filled = max(0, min(width, filled))
    return "█" * filled + "░" * (width - filled)


def normalize_datetime(dt_str: str | None) -> tuple[str | None, datetime | None]:
    """Parse EXIF date string (YYYY:MM:DD HH:MM:SS) into normalized ISO string and datetime."""
    if not dt_str:
        return None, None
    s = str(dt_str).strip()
    if len(s) >= 10 and s[4] == ":" and s[7] == ":":
        s = s[:4] + "-" + s[5:7] + "-" + s[8:]
    try:
        cleaned = s.replace("T", " ")
        if "+" in cleaned:
            cleaned = cleaned.split("+")[0].strip()
        dt = datetime.strptime(cleaned[:19], "%Y-%m-%d %H:%M:%S")
        return dt.strftime("%Y-%m-%d %H:%M:%S"), dt
    except Exception:
        return s, None


def normalize_mode(exp_mode, exp_prog) -> str:
    """Normalize exposure mode / program to concise string."""
    raw = str(exp_prog or exp_mode or "").strip()
    if not raw or raw in ["None", "Not Defined", "0"]:
        raw = str(exp_mode or "").strip()
    if not raw or raw in ["None", "0"]:
        return "-"
    raw_lower = raw.lower()
    if "aperture" in raw_lower:
        return "Aperture Pri"
    elif "shutter" in raw_lower:
        return "Shutter Pri"
    elif "manual" in raw_lower:
        return "Manual"
    elif "program" in raw_lower:
        return "Program AE"
    elif "auto" in raw_lower:
        return "Auto"
    elif "portrait" in raw_lower:
        return "Portrait"
    elif "landscape" in raw_lower:
        return "Landscape"
    elif "night" in raw_lower:
        return "Night"
    return raw[:14]


def normalize_flash(flash_val) -> str:
    """Normalize flash status string."""
    if flash_val is None:
        return "-"
    raw = str(flash_val).strip()
    if not raw or raw in ["None", "0"]:
        return "-"
    raw_lower = raw.lower()
    if "did not fire" in raw_lower or "off" in raw_lower or "no flash" in raw_lower or "not fired" in raw_lower:
        return "Off"
    elif "fired" in raw_lower:
        return "Fired"
    elif "auto" in raw_lower:
        return "Auto"
    return raw[:10]


def extract_with_exiftool(targets: list[str], recursive: bool = False) -> list[dict]:
    """Extract EXIF metadata from targets using exiftool."""
    exiftool_bin = shutil.which("exiftool")
    if not exiftool_bin:
        return []

    cmd = [
        exiftool_bin,
        "-q",
        "-j",
        "-fast",
        "-FileName",
        "-Directory",
        "-FileSize#",
        "-Make",
        "-Model",
        "-Lens",
        "-LensID",
        "-LensModel",
        "-LensSpec",
        "-ISO",
        "-ExposureTime",
        "-FNumber",
        "-FocalLength",
        "-FocalLengthIn35mmFormat",
        "-ExposureCompensation",
        "-ExposureProgram",
        "-ExposureMode",
        "-Flash",
        "-MeteringMode",
        "-WhiteBalance",
        "-GPSPosition",
        "-GPSLatitude",
        "-GPSLongitude",
        "-DateTimeOriginal",
        "-ImageWidth",
        "-ImageHeight",
        "-Megapixels",
    ]
    if recursive:
        cmd.append("-r")

    for ext in IMAGE_EXTENSIONS:
        cmd.extend(["-ext", ext.lstrip(".")])

    cmd.extend(targets)

    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        if proc.returncode != 0 and not proc.stdout.strip():
            return []
        raw_items = json.loads(proc.stdout)
    except Exception:
        return []

    results = []
    for item in raw_items:
        src = item.get("SourceFile", "")
        fname = item.get("FileName") or os.path.basename(src)
        dir_path = item.get("Directory") or os.path.dirname(src)
        full_path = os.path.join(dir_path, fname) if (dir_path and fname) else src

        iso_val = item.get("ISO")
        try:
            iso = int(iso_val) if iso_val is not None else None
        except (ValueError, TypeError):
            iso = None

        raw_shutter = item.get("ExposureTime")
        shutter_sec = parse_shutter_seconds(raw_shutter)

        raw_fnum = item.get("FNumber")
        try:
            fnum = float(raw_fnum) if raw_fnum is not None else None
        except (ValueError, TypeError):
            fnum = None

        raw_focal = item.get("FocalLength")
        try:
            if isinstance(raw_focal, str):
                raw_focal = raw_focal.replace("mm", "").strip()
            focal = float(raw_focal) if raw_focal is not None else None
        except (ValueError, TypeError):
            focal = None

        raw_focal35 = item.get("FocalLengthIn35mmFormat")
        try:
            if isinstance(raw_focal35, str):
                raw_focal35 = raw_focal35.replace("mm", "").strip()
            focal_35 = int(round(float(raw_focal35))) if raw_focal35 is not None else None
        except (ValueError, TypeError):
            focal_35 = None

        raw_ev = item.get("ExposureCompensation")
        try:
            ev = float(raw_ev) if raw_ev is not None else None
        except (ValueError, TypeError):
            ev = None

        raw_size = item.get("FileSize")
        try:
            fsize = int(raw_size) if raw_size is not None else (os.path.getsize(full_path) if os.path.isfile(full_path) else None)
        except Exception:
            fsize = None

        w = item.get("ImageWidth")
        h = item.get("ImageHeight")
        try:
            w = int(w) if w else None
            h = int(h) if h else None
            mp = round((w * h) / 1_000_000, 1) if (w and h) else None
        except Exception:
            w, h, mp = None, None, None

        dt_norm, dt_obj = normalize_datetime(item.get("DateTimeOriginal"))

        # Camera make and model
        make = item.get("Make")
        model = item.get("Model")
        if make and model:
            make_clean = make.strip()
            model_clean = model.strip()
            make_short = make_clean.split()[0]
            if model_clean.upper().startswith(make_short.upper()):
                camera_str = model_clean
            else:
                camera_str = f"{make_short} {model_clean}"
        elif model:
            camera_str = model.strip()
        elif make:
            camera_str = make.strip()
        else:
            camera_str = "N/A"

        # Lens identification
        lens_raw = item.get("Lens") or item.get("LensModel") or item.get("LensSpec") or item.get("LensID")
        if not lens_raw and focal:
            lens_raw = f"Built-in ({format_focal(focal)} {format_aperture(fnum)})"
        lens = str(lens_raw).strip() if lens_raw else "-"
        lens_id = item.get("LensID") or lens

        # Photographic settings
        exp_mode_str = normalize_mode(item.get("ExposureMode"), item.get("ExposureProgram"))
        flash_str = normalize_flash(item.get("Flash"))
        metering = item.get("MeteringMode")
        wb = item.get("WhiteBalance")

        # GPS coordinates
        gps = item.get("GPSPosition")
        if not gps and item.get("GPSLatitude") and item.get("GPSLongitude"):
            gps = f"{item.get('GPSLatitude')}, {item.get('GPSLongitude')}"

        # Resolution formatted
        if w and h:
            res_str = f"{w}x{h}" + (f" ({mp}MP)" if mp else "")
        else:
            res_str = "N/A"

        results.append({
            "path": full_path,
            "filename": fname,
            "directory": dir_path,
            "size_bytes": fsize,
            "size_formatted": format_bytes(fsize),
            "make": make.strip() if make else None,
            "model": model.strip() if model else None,
            "camera": camera_str,
            "lens": lens,
            "lens_id": lens_id,
            "datetime_str": dt_norm,
            "datetime_obj": dt_obj,
            "iso": iso,
            "shutter_sec": shutter_sec,
            "shutter_str": format_shutter(shutter_sec, raw_shutter),
            "f_number": fnum,
            "focal_length": focal,
            "focal_length_35mm": focal_35,
            "focal_str": format_focal(focal, focal_35),
            "exposure_bias": ev,
            "exposure_bias_str": format_ev(raw_ev),
            "exposure_mode": exp_mode_str,
            "flash": flash_str,
            "metering": metering,
            "white_balance": wb,
            "gps": gps,
            "width": w,
            "height": h,
            "megapixels": mp,
            "resolution_str": res_str,
            "has_exif": any(v is not None for v in [iso, shutter_sec, fnum, model]),
        })

    return results


def extract_with_pillow(file_paths: list[str]) -> list[dict]:
    """Extract EXIF metadata using pure-Python Pillow as a standalone engine."""
    if not HAS_PILLOW:
        return []

    results = []
    for p in file_paths:
        fname = os.path.basename(p)
        dir_path = os.path.dirname(p)
        fsize = os.path.getsize(p) if os.path.isfile(p) else None

        try:
            with Image.open(p) as img:
                w, h = img.size
                mp = round((w * h) / 1_000_000, 1)

                exif = img.getexif()
                ifd = exif.get_ifd(ExifTags.IFD.Exif) if exif else {}

                make = exif.get(ExifTags.Base.Make)
                model = exif.get(ExifTags.Base.Model)
                if make and model:
                    make_clean = str(make).strip()
                    model_clean = str(model).strip()
                    make_short = make_clean.split()[0]
                    camera_str = model_clean if model_clean.upper().startswith(make_short.upper()) else f"{make_short} {model_clean}"
                elif model:
                    camera_str = str(model).strip()
                elif make:
                    camera_str = str(make).strip()
                else:
                    camera_str = "N/A"

                raw_dt = ifd.get(ExifTags.Base.DateTimeOriginal) or exif.get(ExifTags.Base.DateTime)
                dt_norm, dt_obj = normalize_datetime(str(raw_dt) if raw_dt else None)

                iso_raw = ifd.get(ExifTags.Base.ISOSpeedRatings) or exif.get(ExifTags.Base.ISOSpeedRatings)
                try:
                    iso = int(iso_raw) if iso_raw is not None else None
                except Exception:
                    iso = None

                shutter_raw = ifd.get(ExifTags.Base.ExposureTime)
                shutter_sec = parse_shutter_seconds(shutter_raw)

                fnum_raw = ifd.get(ExifTags.Base.FNumber)
                try:
                    fnum = float(fnum_raw) if fnum_raw is not None else None
                except Exception:
                    fnum = None

                focal_raw = ifd.get(ExifTags.Base.FocalLength)
                try:
                    focal = float(focal_raw) if focal_raw is not None else None
                except Exception:
                    focal = None

                focal35_raw = ifd.get(ExifTags.Base.FocalLengthIn35mmFilm)
                try:
                    focal35 = int(round(float(focal35_raw))) if focal35_raw is not None else None
                except Exception:
                    focal35 = None

                lens_raw = ifd.get(ExifTags.Base.LensModel) or ifd.get(ExifTags.Base.LensSpecification)
                lens = str(lens_raw).strip() if lens_raw else "-"

                ev_raw = ifd.get(ExifTags.Base.ExposureBiasValue)
                try:
                    ev = float(ev_raw) if ev_raw is not None else None
                except Exception:
                    ev = None

                exp_prog = ifd.get(ExifTags.Base.ExposureProgram)
                exp_mode = ifd.get(ExifTags.Base.ExposureMode)
                mode_str = normalize_mode(exp_mode, exp_prog)

                flash_raw = ifd.get(ExifTags.Base.Flash)
                flash_str = normalize_flash(flash_raw)

                metering = ifd.get(ExifTags.Base.MeteringMode)
                wb = ifd.get(ExifTags.Base.WhiteBalance)

                res_str = f"{w}x{h} ({mp}MP)"

                results.append({
                    "path": p,
                    "filename": fname,
                    "directory": dir_path,
                    "size_bytes": fsize,
                    "size_formatted": format_bytes(fsize),
                    "make": str(make).strip() if make else None,
                    "model": str(model).strip() if model else None,
                    "camera": camera_str,
                    "lens": lens,
                    "lens_id": lens,
                    "datetime_str": dt_norm,
                    "datetime_obj": dt_obj,
                    "iso": iso,
                    "shutter_sec": shutter_sec,
                    "shutter_str": format_shutter(shutter_sec, shutter_raw),
                    "f_number": fnum,
                    "focal_length": focal,
                    "focal_length_35mm": focal35,
                    "focal_str": format_focal(focal, focal35),
                    "exposure_bias": ev,
                    "exposure_bias_str": format_ev(ev_raw),
                    "exposure_mode": mode_str,
                    "flash": flash_str,
                    "metering": str(metering) if metering else None,
                    "white_balance": str(wb) if wb else None,
                    "gps": None,
                    "width": w,
                    "height": h,
                    "megapixels": mp,
                    "resolution_str": res_str,
                    "has_exif": any(v is not None for v in [iso, shutter_sec, fnum, model]),
                })
        except Exception:
            results.append({
                "path": p,
                "filename": fname,
                "directory": dir_path,
                "size_bytes": fsize,
                "size_formatted": format_bytes(fsize),
                "make": None,
                "model": None,
                "camera": "N/A",
                "lens": "-",
                "lens_id": "-",
                "datetime_str": None,
                "datetime_obj": None,
                "iso": None,
                "shutter_sec": None,
                "shutter_str": "N/A",
                "f_number": None,
                "focal_length": None,
                "focal_length_35mm": None,
                "focal_str": "N/A",
                "exposure_bias": None,
                "exposure_bias_str": "0.0",
                "exposure_mode": "-",
                "flash": "-",
                "metering": None,
                "white_balance": None,
                "gps": None,
                "width": None,
                "height": None,
                "megapixels": None,
                "resolution_str": "N/A",
                "has_exif": False,
            })

    return results


def find_files(targets: list[str], recursive: bool = False) -> list[str]:
    """Find all image files matching target paths or directories."""
    files = []
    for t in targets:
        p = Path(t).resolve()
        if p.is_file():
            if p.suffix.lower() in IMAGE_EXTENSIONS:
                files.append(str(p))
        elif p.is_dir():
            pattern = "**/*" if recursive else "*"
            for item in p.glob(pattern):
                if item.is_file() and item.suffix.lower() in IMAGE_EXTENSIONS:
                    files.append(str(item))
    return sorted(set(files))


def calculate_stats(records: list[dict]) -> dict:
    """Calculate aggregate statistics from photo records."""
    total_images = len(records)
    exif_images = [r for r in records if r["has_exif"]]
    total_size = sum(r["size_bytes"] or 0 for r in records)

    dates = [r["datetime_obj"] for r in exif_images if r.get("datetime_obj")]
    earliest_date = min(dates) if dates else None
    latest_date = max(dates) if dates else None
    span = (latest_date - earliest_date) if (earliest_date and latest_date) else None

    cameras = Counter(r["camera"] for r in exif_images if r.get("camera") and r["camera"] != "N/A")
    lenses = Counter(r["lens"] for r in exif_images if r.get("lens") and r["lens"] != "-")
    modes = Counter(r["exposure_mode"] for r in exif_images if r.get("exposure_mode") and r["exposure_mode"] != "-")
    flashes = Counter(r["flash"] for r in exif_images if r.get("flash") and r["flash"] != "-")
    gps_count = sum(1 for r in exif_images if r.get("gps"))

    isos = [r["iso"] for r in exif_images if r.get("iso") is not None]
    iso_stats = {}
    if isos:
        iso_counts = Counter(isos)
        iso_stats = {
            "min": min(isos),
            "max": max(isos),
            "median": int(median(isos)),
            "mean": round(mean(isos)),
            "counts": dict(sorted(iso_counts.items())),
        }

    shutters = [r["shutter_sec"] for r in exif_images if r.get("shutter_sec") is not None]
    shutter_strings = Counter(r["shutter_str"] for r in exif_images if r.get("shutter_str") and r["shutter_str"] != "N/A")
    shutter_stats = {}
    if shutters:
        shutter_stats = {
            "fastest_sec": min(shutters),
            "fastest_str": format_shutter(min(shutters)),
            "slowest_sec": max(shutters),
            "slowest_str": format_shutter(max(shutters)),
            "median_str": format_shutter(median(shutters)),
            "top_counts": shutter_strings.most_common(8),
        }

    fnums = [r["f_number"] for r in exif_images if r.get("f_number") is not None]
    fnum_strings = Counter(format_aperture(r["f_number"]) for r in exif_images if r.get("f_number") is not None)
    aperture_stats = {}
    if fnums:
        aperture_stats = {
            "widest": format_aperture(min(fnums)),
            "narrowest": format_aperture(max(fnums)),
            "median": format_aperture(median(fnums)),
            "top_counts": fnum_strings.most_common(8),
        }

    focals = [r["focal_length"] for r in exif_images if r.get("focal_length") is not None]
    focal_strings = Counter(format_focal(r["focal_length"]) for r in exif_images if r.get("focal_length") is not None)
    focal_stats = {}
    if focals:
        focal_stats = {
            "shortest": format_focal(min(focals)),
            "longest": format_focal(max(focals)),
            "median": format_focal(median(focals)),
            "top_counts": focal_strings.most_common(8),
        }

    return {
        "total_images": total_images,
        "images_with_exif": len(exif_images),
        "total_size_bytes": total_size,
        "total_size_formatted": format_bytes(total_size),
        "earliest_date": earliest_date.strftime("%Y-%m-%d %H:%M:%S") if earliest_date else None,
        "latest_date": latest_date.strftime("%Y-%m-%d %H:%M:%S") if latest_date else None,
        "date_span": format_span(span) if span else None,
        "cameras": dict(cameras.most_common()),
        "lenses": dict(lenses.most_common()),
        "exposure_modes": dict(modes.most_common()),
        "flashes": dict(flashes.most_common()),
        "gps_count": gps_count,
        "iso": iso_stats,
        "shutter": shutter_stats,
        "aperture": aperture_stats,
        "focal_length": focal_stats,
    }


def get_console(use_color: bool = True) -> Console:
    """Create a configured Rich console instance."""
    term_cols, term_rows = shutil.get_terminal_size((165, 40))
    if term_cols < 130 and (os.environ.get("TERM") == "dumb" or not sys.stdout.isatty()):
        effective_w = max(term_cols, 165)
        return Console(width=effective_w, height=term_rows, no_color=not use_color)
    return Console(no_color=not use_color)


def print_rich_table(
    records: list[dict],
    target_label: str = "",
    use_color: bool = True,
    limit: int | None = None,
    show_date: bool = False,
    show_camera: bool = False,
    show_mode: bool = False,
    show_flash: bool = False,
) -> None:
    """Print photo metadata table using Rich."""
    console = get_console(use_color=use_color)
    title_str = f"[bold cyan]Photo EXIF Metadata: {target_label}[/bold cyan]" if target_label else "[bold cyan]Photo EXIF Metadata[/bold cyan]"

    table = Table(
        title=title_str,
        box=box.ROUNDED,
        header_style="bold cyan",
        show_lines=False,
        row_styles=["", "dim"],
    )

    table.add_column("#", justify="right", style="dim", no_wrap=True)
    table.add_column("File", style="bold bright_white", overflow="fold")
    if show_date:
        table.add_column("Date / Time", style="dim", min_width=17, overflow="fold")
    if show_camera:
        table.add_column("Camera", style="white", min_width=12, overflow="fold")
    table.add_column("Lens", style="green", overflow="fold")
    table.add_column("Focal", justify="right", style="cyan", overflow="fold")
    table.add_column("Shutter", justify="right", style="bold yellow", no_wrap=True)
    table.add_column("Aperture", justify="right", style="bold green", no_wrap=True)
    table.add_column("ISO", justify="right", no_wrap=True)
    table.add_column("EV", justify="right", style="dim", no_wrap=True)
    if show_mode:
        table.add_column("Mode", style="magenta", overflow="fold")
    if show_flash:
        table.add_column("Flash", style="dim", no_wrap=True)
    table.add_column("Resolution", justify="right", style="blue", overflow="fold")
    table.add_column("Size", justify="right", style="dim", no_wrap=True)

    shown = records[:limit] if (limit and limit > 0) else records
    for idx, r in enumerate(shown, 1):
        iso = r["iso"]
        if iso is not None:
            iso_color = "green" if iso <= 400 else ("yellow" if iso <= 1600 else "magenta")
            iso_str = f"[{iso_color}]{iso}[/{iso_color}]"
        else:
            iso_str = "[dim]N/A[/dim]"

        shut_str = r["shutter_str"]
        ap_str = format_aperture(r["f_number"])
        focal_str = r.get("focal_str") or format_focal(r["focal_length"], r["focal_length_35mm"])
        ev_str = r.get("exposure_bias_str") or format_ev(r["exposure_bias"])
        cam_str = r.get("camera") or "N/A"
        lens_str = r.get("lens") or "-"
        dt_str = r.get("datetime_str") or "N/A"
        mode_str = r.get("exposure_mode") or "-"
        flash_str = r.get("flash") or "-"
        res_str = r.get("resolution_str") or "N/A"
        size_str = r.get("size_formatted") or "N/A"

        row = [str(idx), r["filename"]]
        if show_date:
            row.append(dt_str)
        if show_camera:
            row.append(cam_str)
        row.extend([lens_str, focal_str, shut_str, ap_str, iso_str, ev_str])
        if show_mode:
            row.append(mode_str)
        if show_flash:
            row.append(flash_str)
        row.extend([res_str, size_str])

        table.add_row(*row)

    console.print(table)
    if limit and limit > 0 and len(records) > limit:
        console.print(f"[dim]... showing {limit} of {len(records)} images (use --limit 0 to display all)[/dim]\n")


