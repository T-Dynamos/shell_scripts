def normalize_argv(argv: list[str]) -> list[str]:
    """Pre-normalize command-line arguments to handle compound shortcuts like '--sort --shutter'."""
    normalized = []
    i = 0
    sort_fields = {"name", "date", "iso", "shutter", "aperture", "focal", "size"}
    while i < len(argv):
        arg = argv[i]
        if arg == "--sort" and i + 1 < len(argv):
            next_arg = argv[i + 1]
            if next_arg.startswith("--") and next_arg[2:] in sort_fields:
                normalized.extend(["--sort", next_arg[2:], "--bare"])
                i += 2
                continue
            elif next_arg.startswith("-") and next_arg[1:] in sort_fields:
                normalized.extend(["--sort", next_arg[1:], "--bare"])
                i += 2
                continue
        elif arg.startswith("--sort=--"):
            field = arg[9:]
            if field in sort_fields:
                normalized.extend(["--sort", field, "--bare"])
                i += 1
                continue
        normalized.append(arg)
        i += 1
    return normalized


def print_bare(
    records: list[dict],
    target_path: Path,
    sort_field: str = "shutter",
    filenames_only: bool = False,
    with_value: bool = False,
    limit: int | None = None,
    backslash: bool = True,
) -> None:
    """Print bare list of image files/paths, one per line, suitable for copy-pasting."""
    import shlex
    shown = records[:limit] if (limit and limit > 0) else records
    is_curr_dir = (target_path.resolve() == Path(".").resolve())

    for r in shown:
        if filenames_only:
            raw_path = r["filename"]
        elif is_curr_dir:
            try:
                rel = os.path.relpath(r["path"], start=".")
                raw_path = rel if not rel.startswith("./") else rel[2:]
            except ValueError:
                raw_path = r["filename"]
        else:
            raw_path = r["path"]

        quoted_path = shlex.quote(raw_path)
        out_str = f"{quoted_path} \\" if backslash else quoted_path

        if with_value:
            if sort_field == "shutter":
                val_str = r.get("shutter_str") or "N/A"
            elif sort_field == "iso":
                val_str = f"ISO {r.get('iso', 'N/A')}"
            elif sort_field == "aperture":
                val_str = format_aperture(r.get("f_number"))
            elif sort_field == "focal":
                val_str = r.get("focal_str") or "N/A"
            elif sort_field == "date":
                val_str = r.get("datetime_str") or "N/A"
            elif sort_field == "size":
                val_str = r.get("size_formatted") or "N/A"
            else:
                val_str = ""
            print(f"{val_str:<10}\t{out_str}" if val_str else out_str)
        else:
            print(out_str)


def print_csv(records: list[dict]) -> None:
    """Print photo records in CSV format."""
    import csv
    writer = csv.writer(sys.stdout)
    writer.writerow([
        "filename", "directory", "datetime", "make", "model", "camera", "lens",
        "iso", "shutter_seconds", "shutter_string", "f_number",
        "focal_length", "focal_length_35mm", "exposure_bias", "exposure_mode",
        "flash", "metering", "white_balance", "gps",
        "width", "height", "megapixels", "file_size_bytes", "file_size_formatted"
    ])
    for r in records:
        writer.writerow([
            r["filename"], r["directory"], r["datetime_str"] or "",
            r["make"] or "", r["model"] or "", r["camera"] or "", r["lens"] or "",
            r["iso"] or "", r["shutter_sec"] or "", r["shutter_str"],
            r["f_number"] or "", r["focal_length"] or "",
            r["focal_length_35mm"] or "", r["exposure_bias"] or "",
            r.get("exposure_mode") or "", r.get("flash") or "",
            r.get("metering") or "", r.get("white_balance") or "", r.get("gps") or "",
            r["width"] or "", r["height"] or "", r["megapixels"] or "",
            r["size_bytes"] or "", r["size_formatted"] or "",
        ])


