#!/usr/bin/env python3
"""
td_script_info - Summarize all T-Dynamos (td_*) shell scripts with one-line descriptions and example usage.
Part of T-Dynamos shell_scripts.
"""

import sys
import os
import json
import shutil
import argparse
from pathlib import Path

# Resolve shared data directory and insert into sys.path
_DATA_DIR = Path(__file__).resolve().parent / "td_script_data"
if not _DATA_DIR.is_dir():
    _DATA_DIR = Path.home() / ".local" / "bin" / "td_script_data"
if str(_DATA_DIR) not in sys.path:
    sys.path.insert(0, str(_DATA_DIR))

from catalog import SCRIPTS
from common import Colors, supports_color


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="td_script_info",
        description="Summarize all T-Dynamos (td_*) scripts with one-line descriptions and example usage.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  %(prog)s
  %(prog)s td_math2img
  %(prog)s --compact
  %(prog)s --json
""",
    )
    parser.add_argument(
        "script",
        nargs="?",
        choices=list(SCRIPTS.keys()),
        help="Optional: name of a specific td_* script to inspect.",
    )
    parser.add_argument(
        "-c",
        "--compact",
        action="store_true",
        help="Display ultra-compact one-line summary per script.",
    )
    parser.add_argument(
        "-j",
        "--json",
        action="store_true",
        help="Output scripts metadata in JSON format.",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI colored output.",
    )
    return parser


def check_installed(name: str) -> bool:
    """Check if script is available in user's PATH."""
    return shutil.which(name) is not None


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    use_color = supports_color(args.no_color)

    # Filter target scripts
    targets = {args.script: SCRIPTS[args.script]} if args.script else SCRIPTS

    if args.json:
        result = {}
        for name, meta in targets.items():
            result[name] = {
                **meta,
                "installed_in_path": check_installed(name),
                "path": shutil.which(name),
            }
        print(json.dumps(result, indent=2))
        return 0

    cyan = Colors.BOLD_CYAN if use_color else ""
    green = Colors.BOLD_GREEN if use_color else ""
    yellow = Colors.BOLD_YELLOW if use_color else ""
    bold = Colors.BOLD if use_color else ""
    dim = Colors.DIM if use_color else ""
    reset = Colors.RESET if use_color else ""

    if args.compact:
        max_name_len = max(len(name) for name in targets)
        for name, meta in targets.items():
            print(f"{green}{name:<{max_name_len}}{reset} : {meta['summary']}")
            print(f"{' ' * max_name_len}   {dim}Example: {meta['example']}{reset}")
        return 0

    print(f"{cyan}================================================================================{reset}")
    print(f"{bold}                 T-Dynamos Shell Scripts Catalog (td_*)                        {reset}")
    print(f"{cyan}================================================================================{reset}")

    for idx, (name, meta) in enumerate(targets.items(), 1):
        in_path = check_installed(name)
        status_tag = f"{green}[installed in PATH]{reset}" if in_path else f"{dim}[not in PATH]{reset}"

        print(f"\n{bold}{idx}. {green}{name}{reset}  {status_tag}")
        print(f"   {bold}Title   :{reset} {meta['title']} ({dim}{meta['category']}{reset})")
        print(f"   {bold}Summary :{reset} {meta['summary']}")
        print(f"   {bold}Example :{reset} {yellow}{meta['example']}{reset}")

    print(f"\n{cyan}--------------------------------------------------------------------------------{reset}")
    print(f"{dim}To install/update all scripts to ~/.local/bin:{reset}")
    print(f"  ./install.sh\n")

    return 0


if __name__ == "__main__":
    sys.exit(main())
