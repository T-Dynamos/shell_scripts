#!/usr/bin/env python3
"""
td_script_info - Summarize all T-Dynamos (td_*) shell scripts with one-line descriptions and example usage.
Part of T-Dynamos shell_scripts.
"""

import sys
import os
import json
import shutil
import argparse

SCRIPTS = {
    "td_math2png": {
        "title": "LaTeX Math to PNG & Clipboard",
        "summary": "Render LaTeX math expressions to high-resolution PNG, copy to Wayland clipboard with wl-copy, and preview in swayimg.",
        "example": "td_math2png -s '\\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}'",
        "category": "Graphics & Math",
    },
    "td_battery_info": {
        "title": "Battery Diagnostics & Health",
        "summary": "Display battery health percentage, full/design capacity in mAh, and CC phase charging current estimate.",
        "example": "td_battery_info --short",
        "category": "System & Hardware",
    },
    "td_battery_watch": {
        "title": "Live Terminal Battery Monitor",
        "summary": "Real-time dashboard tracking battery charge, charge/discharge rate in mA/W, progress bar, and time remaining.",
        "example": "td_battery_watch -i 1.0",
        "category": "System & Hardware",
    },
    "td_script_info": {
        "title": "Scripts Catalog & Quick Help",
        "summary": "Summarize all td_* scripts with one-line descriptions, categories, and command examples.",
        "example": "td_script_info",
        "category": "Meta & Help",
    },
}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="td_script_info",
        description="Summarize all T-Dynamos (td_*) scripts with one-line descriptions and example usage.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  %(prog)s
  %(prog)s td_math2png
  %(prog)s --compact
  %(prog)s --json
""",
    )
    parser.add_argument(
        "script",
        nargs="?",
        choices=list(SCRIPTS.keys()),
        help="Optional: name of a specific td_* script to inspect.",
    )
    parser.add_argument(
        "-c",
        "--compact",
        action="store_true",
        help="Display ultra-compact one-line summary per script.",
    )
    parser.add_argument(
        "-j",
        "--json",
        action="store_true",
        help="Output scripts metadata in JSON format.",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI colored output.",
    )
    return parser


def check_installed(name: str) -> bool:
    """Check if script is available in user's PATH."""
    return shutil.which(name) is not None


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    use_color = sys.stdout.isatty() and not args.no_color

    # Filter target scripts
    targets = {args.script: SCRIPTS[args.script]} if args.script else SCRIPTS

    if args.json:
        result = {}
        for name, meta in targets.items():
            result[name] = {
                **meta,
                "installed_in_path": check_installed(name),
                "path": shutil.which(name),
            }
        print(json.dumps(result, indent=2))
        return 0

    cyan = "\033[1;36m" if use_color else ""
    green = "\033[1;32m" if use_color else ""
    yellow = "\033[1;33m" if use_color else ""
    bold = "\033[1m" if use_color else ""
    dim = "\033[2m" if use_color else ""
    reset = "\033[0m" if use_color else ""

    if args.compact:
        max_name_len = max(len(name) for name in targets)
        for name, meta in targets.items():
            print(f"{green}{name:<{max_name_len}}{reset} : {meta['summary']}")
            print(f"{' ' * max_name_len}   {dim}Example: {meta['example']}{reset}")
        return 0

    print(f"{cyan}================================================================================{reset}")
    print(f"{bold}                 T-Dynamos Shell Scripts Catalog (td_*)                        {reset}")
    print(f"{cyan}================================================================================{reset}")

    for idx, (name, meta) in enumerate(targets.items(), 1):
        in_path = check_installed(name)
        status_tag = f"{green}[installed in PATH]{reset}" if in_path else f"{dim}[not in PATH]{reset}"

        print(f"\n{bold}{idx}. {green}{name}{reset}  {status_tag}")
        print(f"   {bold}Title   :{reset} {meta['title']} ({dim}{meta['category']}{reset})")
        print(f"   {bold}Summary :{reset} {meta['summary']}")
        print(f"   {bold}Example :{reset} {yellow}{meta['example']}{reset}")

    print(f"\n{cyan}--------------------------------------------------------------------------------{reset}")
    print(f"{dim}To install/update all scripts to ~/.local/bin:{reset}")
    print(f"  mkdir -p ~/.local/bin && install -m 755 td_* ~/.local/bin/\n")

    return 0


if __name__ == "__main__":
    sys.exit(main())
