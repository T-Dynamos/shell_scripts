#!/usr/bin/env python3
"""
td_tmp_clean - Clean temporary image files in /tmp created by math rendering and tools.
Part of T-Dynamos shell_scripts.
"""

import sys
import os
import re
import time
import json
import argparse
from pathlib import Path

# Resolve shared data directory and insert into sys.path
_DATA_DIR = Path(__file__).resolve().parent / "td_script_data"
if not _DATA_DIR.is_dir():
    _DATA_DIR = Path.home() / ".local" / "bin" / "td_script_data"
if str(_DATA_DIR) not in sys.path:
    sys.path.insert(0, str(_DATA_DIR))

from common import (
    format_size,
    parse_duration,
    Colors,
    supports_color,
)

DEFAULT_EXTENSIONS = {
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".svg",
    ".gif",
    ".bmp",
    ".avif",
    ".jxl",
    ".tiff",
}

DEFAULT_PREFIXES = (
    "math_",
    "magick-",
    "swayimg-",
    "test_",
)


def find_temp_images(
    target_dir: Path,
    all_images: bool = False,
    pattern: str | None = None,
    older_than_sec: float | None = None,
) -> list[tuple[Path, int]]:
    """Find matching temporary image files owned by the current user."""
    my_uid = os.getuid()
    now = time.time()
    matches = []

    if not target_dir.is_dir():
        return matches

    try:
        entries = list(target_dir.iterdir())
    except PermissionError:
        return matches

    for entry in entries:
        if not entry.is_file():
            continue

        try:
            st = entry.stat()
        except OSError:
            continue

        # Strictly check ownership to only touch current user's files
        if st.st_uid != my_uid:
            continue

        # Check age filter if provided
        if older_than_sec is not None:
            age = now - st.st_mtime
            if age < older_than_sec:
                continue

        name = entry.name.lower()

        # Check pattern if custom pattern passed
        if pattern:
            if not entry.match(pattern):
                continue
            matches.append((entry, st.st_size))
            continue

        # Extension check
        ext = entry.suffix.lower()
        is_image_ext = ext in DEFAULT_EXTENSIONS
        is_temp_prefix = any(name.startswith(p) for p in DEFAULT_PREFIXES)

        # By default match:
        # 1. Any image matching temp prefix (math_*, magick-*, test_*, swayimg-*)
        # 2. Or if --all is specified, any image file in target dir
        if is_temp_prefix and (is_image_ext or name.startswith("magick-")):
            matches.append((entry, st.st_size))
        elif all_images and is_image_ext:
            matches.append((entry, st.st_size))

    return matches


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="td_tmp_clean",
        description="Clean temporary image files in /tmp generated by math rendering and tools.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  %(prog)s
  %(prog)s --dry-run
  %(prog)s --all
  %(prog)s --older-than 1h
  %(prog)s -p 'math_*.png'
  %(prog)s -v
  %(prog)s --json
""",
    )
    parser.add_argument(
        "-d",
        "--dir",
        metavar="DIR",
        default="/tmp",
        help="Target temporary directory to clean (default: /tmp).",
    )
    parser.add_argument(
        "-a",
        "--all",
        action="store_true",
        help="Clean all user-owned images in target dir, not just math/magick temporary prefixes.",
    )
    parser.add_argument(
        "-p",
        "--pattern",
        metavar="GLOB",
        help="Custom glob pattern of files to clean (e.g. 'math_*.png', 'test_*.png').",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Scan and list files that would be removed without actually deleting them.",
    )
    parser.add_argument(
        "--older-than",
        metavar="TIME",
        help="Only delete images older than duration (e.g. '30m', '2h', '1d').",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="List every file path deleted or scanned.",
    )
    parser.add_argument(
        "-j",
        "--json",
        action="store_true",
        help="Output results in JSON format.",
    )
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="Suppress all informational output except errors.",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI terminal colors.",
    )
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    use_color = sys.stdout.isatty() and not args.no_color
    bold = "\033[1m" if use_color else ""
    green = "\033[1;32m" if use_color else ""
    yellow = "\033[1;33m" if use_color else ""
    red = "\033[1;31m" if use_color else ""
    dim = "\033[2m" if use_color else ""
    reset = "\033[0m" if use_color else ""

    target_dir = Path(args.dir).resolve()
    if not target_dir.is_dir():
        sys.stderr.write(f"Error: Target directory '{target_dir}' does not exist.\n")
        return 1

    older_than_sec = None
    if args.older_than:
        try:
            older_than_sec = parse_duration(args.older_than)
        except ValueError as e:
            sys.stderr.write(f"Error: {e}\n")
            return 1

    files = find_temp_images(
        target_dir=target_dir,
        all_images=args.all,
        pattern=args.pattern,
        older_than_sec=older_than_sec,
    )

    total_bytes = sum(size for _, size in files)
    count = len(files)

    # Dry run preview
    if args.dry_run:
        if args.json:
            result = {
                "dry_run": True,
                "directory": str(target_dir),
                "count": count,
                "total_bytes": total_bytes,
                "files": [str(path) for path, _ in files],
            }
            print(json.dumps(result, indent=2))
            return 0

        if not args.quiet:
            print(f"{yellow}[Dry Run]{reset} Found {bold}{count}{reset} temporary image(s) ({format_size(total_bytes)}) in {target_dir}:")
            if args.verbose or count <= 15:
                for path, size in files:
                    print(f"  {dim}- {path} ({format_size(size)}){reset}")
            else:
                for path, size in files[:10]:
                    print(f"  {dim}- {path} ({format_size(size)}){reset}")
                print(f"  {dim}... and {count - 10} more files (use -v to see all){reset}")
        return 0

    if count == 0:
        if args.json:
            print(json.dumps({"directory": str(target_dir), "count": 0, "total_bytes": 0}))
        elif not args.quiet:
            print(f"No temporary image files found in {target_dir}.")
        return 0

    deleted_count = 0
    deleted_bytes = 0
    errors = []

    for path, size in files:
        try:
            path.unlink()
            deleted_count += 1
            deleted_bytes += size
            if args.verbose and not args.quiet:
                print(f"  {dim}Removed: {path}{reset}")
        except OSError as e:
            errors.append((str(path), str(e)))

    if args.json:
        result = {
            "directory": str(target_dir),
            "deleted_count": deleted_count,
            "deleted_bytes": deleted_bytes,
            "errors": errors,
        }
        print(json.dumps(result, indent=2))
        return 0

    if not args.quiet:
        print(
            f"{green}✓ Cleaned {deleted_count} temporary image(s){reset} "
            f"({format_size(deleted_bytes)} freed) from {target_dir}."
        )
        if errors:
            print(f"{red}Warning: Failed to delete {len(errors)} file(s).{reset}")
            if args.verbose:
                for p, err in errors:
                    print(f"  - {p}: {err}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
